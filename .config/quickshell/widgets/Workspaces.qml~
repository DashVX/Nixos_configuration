import QtQuick
import Quickshell
import Quickshell.Hyprland

Row {
  spacing: 0 
    
  Repeater {
    model: Hyprland.workspaces.values

    Rectangle {
      required property var modelData

      width: 25
      height: 30

      color:     "#313244"

      Text {
        anchors.centerIn: parent
        text: modelData.id
        color: modelData.active ? "#89b4fa" : "#cdd6f4"
        font.bold: modelData.active ? true : false
        font.pixelSize: 12
      }

      MouseArea {
        anchors.fill: parent
        cursorShape: Qt.PointingHandCursor
        // Dispatch a workspace command directly to Hyprland on click
        onClicked: Hyprland.dispatch(`workspace ${modelData.id}`)
      }

    }
  }
}
