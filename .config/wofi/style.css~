* {
  border-radius: 0px;
}

window {
  font-family: "0xProtoNerdFontMono";
  font-size: 20px;
  background-color: rgb(30, 30, 46);
  color: #CDD6F4;
}

#outer-box {
  background-color: rgb(30, 30, 46);
  border: solid 2px #B4BEFE;
}

#inner-box {
  margin: 20px;
  padding: 3px;
  margin: 5px;
}

#input {
  color: #F5E0DC;
  background-color: #313244;
  margin: 10px;
}

#entry:selected {
  background-color: #B4BEFE;
}

#text:selected {
  color: #1E1E2E;
}

image {
  margin-left: .25em;
  margin-right: .25em;
}
